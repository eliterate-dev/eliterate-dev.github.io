@page "/posts/tags/{tag}"
@inject IContentService ContentService
@inject NavigationManager NavigationManager

<PageTitle>Eliterate - Posts</PageTitle>

<div class="post-list">
    @foreach (var post in Posts)
    {
        <MetadataCard Model="post"></MetadataCard>
    }
</div>

@code
{
    [Parameter]
    public string Tag { get; set; } = string.Empty;
    public IEnumerable<PostMetadata> Posts { get; set; } = [];
    protected override async Task OnParametersSetAsync()
    {
        var isDev = NavigationManager.BaseUri.Contains("localhost");
        Posts = await ContentService.GetMetadataByTag(Tag, isDev);
    }
}