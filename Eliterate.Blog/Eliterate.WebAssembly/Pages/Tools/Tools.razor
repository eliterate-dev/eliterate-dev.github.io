@page "/tools"
@using Eliterate.WebAssembly.Components.Tools
<PageTitle>Eliterate - Tools</PageTitle>

<div class="tool-shelves" style="@_height">
    <div class="wall">
        <ToolShelves></ToolShelves>
    </div>
    <div class="floor">
    </div>
</div>

@code {
    private string _height => $"--shelf-height:{ShelfHeight}px;";

    [Parameter]
    public double ShelfHeight { get; set; } = 700;
}
