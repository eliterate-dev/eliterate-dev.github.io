@page "/tools/picker"
@using Eliterate.WebAssembly.Tools

<PageTitle>Eliterate - Tools - Picker</PageTitle>

<div class="active-pickers">
    @if (_lastPicker is not null && CurrentPick > 1)
    {
        <div class="picker last" style="background-color:@_lastPicker?.Color">
            <label>Last Picker:</label><h2>@_lastPicker?.Name</h2>
        </div>
    }
    else
    {
        <div></div>
    }
    <div class="picker current" style="background-color:@_currentPicker!.Color">
        <label>Current Picker:</label><h2>@_currentPicker!.Name</h2>
    </div>
    <div class="picker next" style="background-color:@_nextPicker!.Color">
        <label>Next Picker:</label><h2>@_nextPicker!.Name</h2>
    </div>
</div>

<div class="controls">
    <div class="picker-controls">
        <button @onclick="x => CurrentPick--">Previous</button>
        <div>
            <label>Jump to pick number:</label><br />
            <InputNumber @bind-Value="CurrentPick"></InputNumber>
        </div>
        <button @onclick="x => CurrentPick++">Next</button>
    </div>
</div>

<div class="settings">
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div style="text-align:center;color:red;">@_errorMessage</div>
    }
    <FlashCard>
        <div class="card-header">
            <h3>Pickers</h3>
        </div>
        <div class="card-body">
            <ul>
                @foreach (var picker in _pickers)
                {
                    <li>
                        <div hidden="hidden">@picker.Id</div>
                        <InputText @bind-Value="picker.Name"></InputText>
                    </li>
                }
            </ul>
        </div>
        <div class="card-footer">
            <label>Reset number of pickers:</label><InputNumber @bind-Value="Pickers"></InputNumber><button @onclick="x => SetPickers(Pickers)">Set</button>
        </div>
    </FlashCard>
</div>

<div class="explanation">
    <Paper>
        <h3>What is this?</h3>
        <article>
            <p></p>
        </article>
    </Paper>
</div>

@code {
    private List<Picker> _pickers = [];
    private List<int> _sequence = [];
    private string _errorMessage = "";
    private Picker? _lastPicker => GetPicker(_pickers, _sequence, CurrentPick - 1);
    private Picker? _currentPicker => GetPicker(_pickers, _sequence, CurrentPick);
    private Picker? _nextPicker => GetPicker(_pickers, _sequence, CurrentPick + 1);
    private int _currentPick = 1;

    [Parameter]
    [SupplyParameterFromQuery]
    public int Pickers { get; set; } = 2;
    [Parameter]
    [SupplyParameterFromQuery]
    public int InitialPick { get; set; } = 1;

    public int CurrentPick 
    { 
        get => _currentPick; 
        set => _currentPick = Math.Clamp(value, 1, ushort.MaxValue); 
    }

    protected override void OnInitialized()
    {
        CurrentPick = InitialPick;
        SetPickers(2);
        base.OnInitialized();
    }
    protected override void OnParametersSet()
    {
        _errorMessage = "";
        base.OnParametersSet();
    }

    public static Picker? GetPicker(IEnumerable<Picker> pickers, IEnumerable<int> currentSequence, int pick)
    {
        var pickerCount = pickers.Count();
        if (pickerCount < 1 || pick < 1)
            return null;

        pick = Math.Clamp(pick, 1, ushort.MaxValue);
        if (currentSequence.Count() < 1)
            currentSequence = pickers.Select(p => p.Id);

        // making sure I also get "next pick"
        while (currentSequence.Count() < pick + 1)
        {
            currentSequence = [.. AddComplement(currentSequence)];
        }
        return pickers.ElementAt(currentSequence.ElementAt(pick - 1));
    }

    public static IEnumerable<int> AddComplement(IEnumerable<int> sequence)
    {
        List<int> complement = [];
        var max = sequence.Max();
        foreach (var item in sequence)
        {
            complement.Add(max - item);
        }
        // stitch together
        return [.. sequence.Concat(complement)];
    }

    private void SetPickers(int number)
    {
        _errorMessage = "";
        CurrentPick = 1;
        if (number < 2)
        {
            _errorMessage = "Can't have fewer than 2 pickers.";
            return;
        }
        number = Math.Clamp(number, 2, byte.MaxValue);
        _pickers = new List<Picker>();
        for (int i = 0; i < number; i++)
        {
            _pickers.Add(new() { Id = i, Name = $"Picker {i+1}", Color = $"hsl({(360 / number) * i}, 100%, 80%);" });
        }
    }
}
