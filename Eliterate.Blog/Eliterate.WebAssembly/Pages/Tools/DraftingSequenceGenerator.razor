@page "/tools/picker"
@using Eliterate.WebAssembly.Tools

<PageTitle>Eliterate - Tools - Picker</PageTitle>

<div class="controls">
    <FlashCard>
        <div class="picker-controls">
            <label>Current Picker: @_currentPicker.Name</label>
            <button @onclick="x => CurrentPick--">Previous</button>
            <button @onclick="x => CurrentPick++">Next</button>
            <label>Jump to pick number:</label><InputNumber @bind-Value="@CurrentPick"></InputNumber>
        </div>
    </FlashCard>
</div>

<div class="pickers">
    <FlashCard>
        <h3>Pickers</h3>
        <ul>
            @foreach (var picker in _pickers)
            {
                <li>
                    <div hidden="hidden">@picker.Id</div>
                    <InputText @bind-Value="picker.Name"></InputText>
                </li>
            }
        </ul>
    </FlashCard>
</div>

<div class="settings">
    <FlashCard>
        <label>Set number of pickers:</label><InputNumber @bind-Value="@Pickers"></InputNumber><button @onclick="x => SetPickers(Pickers)">Set</button>
    </FlashCard>
</div>

@code {
    private List<Picker> _pickers = [];
    private Picker _currentPicker => GetPicker(_pickers, CurrentPick);
    private string _errorMessage = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public int Pickers { get; set; } = 2;
    [Parameter]
    [SupplyParameterFromQuery]
    public int CurrentPick { get; set; } = 1;

    protected override void OnInitialized()
    {
        SetPickers(2);
        base.OnInitialized();
    }

    public Picker GetPicker(IEnumerable<Picker> pickers, int pick)
    {
        if (_pickers.Count < 1)
            return new() { Id = -1, Name = "No pickers set." };

        pick = Math.Clamp(pick, 1, byte.MaxValue);
        var order = _pickers.Select(x => x.Id);

        while (order.Count() < pick + 1)
        {
            order = [.. order.Concat(order.Reverse())];
        }
        var picker = Math.Clamp(order.ElementAt(pick - 1), 0, pickers.Count());
        return _pickers[picker];
    }

    private void SetPickers(int number)
    {
        CurrentPick = 1;
        if (number < 2)
        {
            _errorMessage = "Can't have fewer than 2 pickers.";
            return;
        }
        _pickers = new List<Picker>();
        for (int i = 0; i < number; i++)
        {
            _pickers.Add(new() { Id = i, Name = $"Picker {i+1}" });
        }
    }
}
