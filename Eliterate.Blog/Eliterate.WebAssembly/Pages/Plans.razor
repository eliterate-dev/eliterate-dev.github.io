@inject IContentService ContentService
@page "/plans"
<PageTitle>Eliterate - Plans & Ideas</PageTitle>

<div class="brick-wall">
    <HorizontalScroller>
        <div class="corkboard">
            @foreach (var idea in _ideas)
            {
                <Paper Link="@idea.Link" LinkText="@idea.LinkText" Rotate="true" HasPins="true">
                    <h2>@idea.Title</h2>
                    <p>
                        @((MarkupString)(idea.Description ?? "No text..."))
                    </p>
                    @if (!string.IsNullOrWhiteSpace(idea.Image))
                    {
                        <div class="image polaroid" role="note" style="@_rotate"><img loading="lazy" alt="@idea.ImageAlt" src="@idea.Image" />@idea.ImageText</div>
                    }
                </Paper>
            }
        </div>
    </HorizontalScroller>
</div>

@code {
    private IEnumerable<Plan> _ideas = [];
    private string _rotate = $"rotate:{Random.Shared.Next(4) - 2}deg;";

    protected override async Task OnInitializedAsync()
    {
        _ideas = [.. await ContentService.GetPlans()];
    }
}
