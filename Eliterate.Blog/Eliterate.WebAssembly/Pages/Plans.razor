@inject IContentService ContentService
@page "/plans"
<PageTitle>Eliterate - Plans & Ideas</PageTitle>

<div class="brick-wall">
    <HorizontalScroller>
        <div class="corkboard">
            @foreach (var idea in _ideas)
            {
                <div class="idea">
                    <Paper Link="@idea.Link" FillHeight="true" LinkText="@idea.LinkText" RotateX="GetRandom()" HasPins="true">
                        <h2>@idea.Title</h2>
                        <p>
                            @((MarkupString)(idea.Description ?? "No text..."))
                        </p>
                        @if (!string.IsNullOrWhiteSpace(idea.Image))
                        {
                            <div class="image polaroid" role="note" style="@($"rotate:{GetRandom()}deg;")"><img loading="lazy" alt="@idea.ImageAlt" src="@idea.Image" />@idea.ImageText</div>
                        }
                    </Paper>
                </div>
            }
        </div>
    </HorizontalScroller>
</div>

@code {
    private IEnumerable<Plan> _ideas = [];

    protected override async Task OnInitializedAsync()
    {
        _ideas = [.. await ContentService.GetPlans()];
    }
    private int GetRandom()
        => Random.Shared.Next(-1, 1);
}
