@page "/credit"
@using Eliterate.WebAssembly.Components.Constructs
@inject IContentService ContentService

<PageTitle>Eliterate - Credit</PageTitle>

<div class="credit-container fill">
    <Book X="300" Y="420" Z="50" RotateX="15" RotateY="-10" RotateZ="183" SpineText="Eliterate">
        <h2 class="center-text">Credit</h2>
        <table>
            @foreach (var item in credits)
            {
                <tr>
                    <td>@(item.Description ?? "Thanks")</td>
                    <td><a href="@item.Link" target="_blank" tabindex="0">@item.Name</a></td>
                </tr>
            }
        </table>

        <div class="qr-code">
            <img src="images/qrcodes/eliterate_patreon.svg" />
        </div>
        <div class="copyright">&copy @DateTime.UtcNow.Year Eliterate</div>

        <TextSticker Text="📱" Right="20" Top="8" FontSize="48" RotateX="20"></TextSticker>
        <TextSticker Text="🪫" Left="25" Bottom="12" FontSize="48" RotateX="80"></TextSticker>
    </Book>
</div>


@code
{
    private IEnumerable<LinkItem> credits = [];

    protected override async Task OnInitializedAsync()
    {
        credits = await ContentService.GetCredits();
    }
}