@using Eliterate.WebAssembly.Components.Constructs
<HorizontalScroller>
    <div class="shelves" style="@_height">
        <div class="shelf-unit shelf-1" style="@_width @_height @_depth">
            <ShelfRack X="ShelfRackWidth" Y="ShelfRackHeight" Z="ShelfRackDepth" MoveY="ShelfRackHeight * 2" MoveZ="ShelfRackDepth * 0.5">
                <div class="shelf-top">
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="-4"></CardboardBox>
                    </a>
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="2"></CardboardBox>
                    </a>
                </div>
            </ShelfRack>
            <ShelfRack X="ShelfRackWidth" Y="ShelfRackHeight" Z="ShelfRackDepth" MoveY="ShelfRackHeight" MoveZ="ShelfRackDepth * 0.5">
                <div class="shelf-top">
                    <a class="shelf-link" href="/tools/qr">
                        <PolaroidCamera X="100" MoveX="65" RotateZ="168"></PolaroidCamera>
                        <Paper CssClass="qr-text-paper">
                            <p>
                                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras mattis malesuada urna, a sollicitudin ante pulvinar et. Nam placerat, risus non auctor lacinia, risus nisi feugiat ipsum, aliquet pretium metus sem eu arcu. Suspendisse nec mi vitae diam malesuada efficitur ut a neque. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Sed vehicula tellus in interdum tincidunt. Praesent eu volutpat dolor. Morbi imperdiet, dui ac tincidunt maximus, augue velit convallis ante, ut aliquet mi eros sed nunc. Maecenas tortor ipsum, semper id est vitae, aliquet finibus tortor.
                            </p>
                            <p>
                                Donec porttitor nulla lectus, vitae sodales turpis aliquet in. Vestibulum id est ac nisi fermentum porttitor. In sem tellus, dignissim non magna at, cursus euismod augue. Nam non dui nunc. Fusce vel consequat nisl. Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae; Aenean arcu leo, varius et condimentum nec, consectetur non dui. Phasellus cursus laoreet orci, vel porta risus cursus at. Donec purus lacus, consequat sit amet tristique ac, imperdiet nec est. Duis turpis risus, efficitur id purus accumsan, pellentesque vulputate eros. Donec interdum malesuada nisl efficitur auctor. Donec placerat erat lorem, ac eleifend elit accumsan non. Vivamus ut elit eget erat condimentum aliquet in sit amet magna.
                            </p>
                        </Paper>
                        <Paper CssClass="qr-code-paper">
                            <p>
                                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras mattis malesuada urna, a sollicitudin ante pulvinar et. Nam placerat, risus non auctor lacinia, risus nisi feugiat ipsum, aliquet pretium metus sem eu arcu. Suspendisse nec mi vitae diam malesuada efficitur ut a neque. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Sed vehicula tellus in interdum tincidunt. Praesent eu volutpat dolor. Morbi imperdiet, dui ac tincidunt maximus, augue velit convallis ante, ut aliquet mi eros sed nunc. Maecenas tortor ipsum, semper id est vitae, aliquet finibus tortor.
                            </p>
                            <div class="polaroid">
                                <img src="/images/qrcodes/eliterate.svg" style="width:80px;height:80px;" />
                            </div>
                        </Paper>
                        <ToolSign Text="QR Code Generator"></ToolSign>
                    </a>
                    <a class="shelf-link" href="/tools/picker">
                        <CardboardBox Label="Picker" IsOpen="true" X="220" Y="160" Z="120" MoveX="30" MoveY="30" RotateZ="15"></CardboardBox>
                    </a>
                </div>
            </ShelfRack>
            <ShelfRack X="ShelfRackWidth" Y="ShelfRackHeight" Z="ShelfRackDepth" MoveZ="ShelfRackDepth * 0.5">
                <div class="shelf-top">
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="-1"></CardboardBox>
                    </a>
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="3"></CardboardBox>
                    </a>
                </div>
            </ShelfRack>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveZ="-10" CssClass="left-back" Color="@ShelfColor"></Cuboid>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveZ="ShelfRackDepth - 10" CssClass="left-front" Color="@ShelfColor"></Cuboid>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveX="ShelfRackWidth - 10" MoveZ="-10" CssClass="right-back" Color="@ShelfColor"></Cuboid>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveX="ShelfRackWidth - 10" MoveZ="ShelfRackDepth - 10" CssClass="right-front" Color="@ShelfColor"></Cuboid>
        </div>
        <div class="shelf-unit shelf-1" style="@_width">
            <ShelfRack X="ShelfRackWidth" Y="ShelfRackHeight" Z="ShelfRackDepth" MoveY="ShelfRackHeight * 2" MoveZ="ShelfRackDepth * 0.5">
                <div class="shelf-top">
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="-3"></CardboardBox>
                    </a>
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="1"></CardboardBox>
                    </a>
                </div>
            </ShelfRack>
            <ShelfRack X="ShelfRackWidth" Y="ShelfRackHeight" Z="ShelfRackDepth" MoveY="ShelfRackHeight" MoveZ="ShelfRackDepth * 0.5">
                <div class="shelf-top">
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="0"></CardboardBox>
                    </a>
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="2"></CardboardBox>
                    </a>
                </div>
            </ShelfRack>
            <ShelfRack X="ShelfRackWidth" Y="ShelfRackHeight" Z="ShelfRackDepth" MoveZ="ShelfRackDepth * 0.5">
                <div class="shelf-top">
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="-1"></CardboardBox>
                    </a>
                    <a class="shelf-link inactive">
                        <CardboardBox X="220" Y="200" Z="120" MoveX="30" MoveY="30" RotateZ="-2"></CardboardBox>
                    </a>
                </div>
            </ShelfRack>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveZ="-10" CssClass="left-back" Color="@ShelfColor"></Cuboid>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveZ="ShelfRackDepth - 10" CssClass="left-front" Color="@ShelfColor"></Cuboid>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveX="ShelfRackWidth - 10" MoveZ="-10" CssClass="right-back" Color="@ShelfColor"></Cuboid>
            <Cuboid X="20" Y="ShelfHeight" Z="20" MoveX="ShelfRackWidth - 10" MoveZ="ShelfRackDepth - 10" CssClass="right-front" Color="@ShelfColor"></Cuboid>
        </div>
    </div>
</HorizontalScroller>

@code {
    private string _height => $"--shelf-height:{ShelfHeight}px;";
    private string _width => $"--shelf-width:{ShelfRackWidth}px;";
    private string _depth => $"--shelf-depth:{ShelfRackDepth}px;";

    private string _moveShelfTwo => $"translate:{ShelfRackWidth}px;";

    [Parameter]
    public double ShelfHeight { get; set; } = 700;
    [Parameter]
    public double ShelfRackHeight { get; set; } = 280;
    [Parameter]
    public double ShelfRackWidth { get; set; } = 600;
    [Parameter]
    public double ShelfRackDepth { get; set; } = 400;
    [Parameter]
    public string ShelfColor { get; set; } = "#111111";
}
