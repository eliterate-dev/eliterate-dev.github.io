@using Eliterate.WebAssembly.Components.Generic.Decorations
@inject IJSRuntime javaScript

@if (Model is null)
{
    <PageNotFound Message="404: Post not found"></PageNotFound>
}
else
{
    <div class="book">
        <div class="book-cover">
            <div class="book-page">
                <div class="book-page-header">
                    <div class="grid-container-dash-dot">
                        <h2 class="book-page-title" tabindex="0" role="heading">@Model.Metadata.Title</h2>
                        <EditOrCreateDate Model="Model.Metadata"></EditOrCreateDate>
                    </div>
                </div>
                <TextSticker Text="@Model.Metadata.StickerEmoji" Top="0.5m" Right="5.5m" Scale="2" Rotate="@Model.Metadata.Title.GetRandomValueFromString(20)"></TextSticker>
                <div class="book-page-body">
                    <article id="top-of-page" class="book-page-text" tabindex="0">
                        @((MarkupString)_htmlFromMarkdown)
                    </article>
                </div>
            </div>
        </div>
        <div class="book-tag-container">
            @foreach (var tag in Model.Metadata.Tags)
            {
                if (string.IsNullOrWhiteSpace(tag))
                    continue;
                <Tag Name="@tag" Classes="book-tag"></Tag>
            } 
        </div>
    </div>
}

@code {
    private string _htmlFromMarkdown => Markdig.Markdown.ToHtml(Model?.Text ?? "Text not found.");
    private Markdig.MarkdownPipeline _pipeline = new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    [Parameter]
    public BlogPost? Model { get; set; }
    public DateTime Date => Model?.Metadata.Edited ?? Model?.Metadata.Created ?? DateTime.UtcNow;
}
