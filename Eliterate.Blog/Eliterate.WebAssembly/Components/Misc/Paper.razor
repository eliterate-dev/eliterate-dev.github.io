@using Codespirals.Blazor.Components.Interfaces

@implements IHasCssClass
@implements IRotatable

<div class="paper @CssClass @(_hasTearoff ? "has-tearoffs" : "")" style="@_rotate @_height @_tearoffHeight">
    @if (HasPins)
    {
        <div class="pins">
            <Pin Left="true" Top="true"></Pin>
            <Pin Right="true" Top="true"></Pin>
        </div>
    }
    <div class="paper-content">
        <div class="paper-text">
            @ChildContent
        </div>
    </div>
    @if (_hasTearoff)
    {
        <div class="tearoff-container">
            @for (int i = 0; i < 6; i++)
            {
                if (i == _skip || i == _skip2)
                {
                    <div class="tearoff tearoff-empty">
                    </div>
                }
                else
                {
                    <a class="tearoff" href="@Link">
                        <div class="tearoff-text">
                            @LinkText
                        </div>
                    </a>
                }
            }
        </div>
    }
</div>

@code {
    private string _height => $"--height:{Height}{_useHeightPercentage};";
    private string _useHeightPercentage => UseHeightPercentage ? "%" : "px";
    private string _rotate => $"rotate:{RotateX}deg;";
    private int _skip = Random.Shared.Next(6);
    private int _skip2 = Random.Shared.Next(6);
    private bool _hasTearoff => Link is not null;
    private string _tearoffHeight => _hasTearoff ? "--tearoff-height:25%;" : "--tearoff-height:0px;";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public int Height { get; set; } = 100;
    [Parameter]
    public bool UseHeightPercentage { get; set; }
    [Parameter]
    public string CssClass { get; set; } = "";
    [Parameter]
    public required string Link { get; set; }
    [Parameter]
    public required string LinkText { get; set; }
    [Parameter]
    public bool HasPins { get; set; }
    [Parameter]
    public double RotateX { get; set; }
}
