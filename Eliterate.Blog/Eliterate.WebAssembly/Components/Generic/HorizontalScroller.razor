
<div class="horizontal-scroller-container" @onclick="SetX" @onmouseover="MouseMove">
    <div id="horizontal-scroller" class="horizontal-scroller">
        @ChildContent
    </div>
</div>

<script>
    document.getElementById("horizontal-scroller").addEventListener("wheel", scrollHorizontally);

    function scrollHorizontally(args)
    {   
        if(args.deltaY > 0)
        {
            this.scrollLeft += 50;
        }
        else {
            this.scrollLeft -= 50;
        }
    }
</script>

@code {
    private double _x = 0;
    private double _deltaX = 0;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private void SetX(MouseEventArgs args)
        => _x = args.ScreenX;

    private void MouseMove(MouseEventArgs args)
    {
        if (args.Button == 0)
        {
            _deltaX = args.ScreenX - _x;
            
        }
    }

}
